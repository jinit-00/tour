PORT=5001
NODE_ENV=production
DATABASE_URL="mysql://avnadmin:your_password@mysql-3e98442e-tour.c.aivencloud.com:12971/defaultdb?ssl-mode=REQUIRED"
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
CLIENT_URL=https://your-domain.com
ALLOWED_ORIGINS=https://your-domain.com,https://your-app.vercel.app

# Optional admin email to automatically grant ADMIN role on login
ADMIN_EMAIL=admin@your-domain.com

# =================================================================
# 1. SIGN IN WITH GOOGLE (OAuth 2.0 Web Authentication)
# =================================================================
# Used by Passport Google Strategy for website user authentication
GOOGLE_SIGNIN_CLIENT_ID=your_google_signin_client_id.apps.googleusercontent.com
GOOGLE_SIGNIN_CLIENT_SECRET=your_google_signin_client_secret
# On GoDaddy monolith, this is https://your-domain.com/api/auth/google/callback
GOOGLE_SIGNIN_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# =================================================================
# 2. SEND GMAIL OTPS (Nodemailer via Gmail API OAuth 2.0)
# =================================================================
# The Gmail address that will send the verification OTP emails
GMAIL_API_USER=your_company_email@gmail.com

# Google Cloud OAuth 2.0 Client Credentials with Gmail API (https://mail.google.com/) scope
GMAIL_API_CLIENT_ID=your_gmail_api_client_id.apps.googleusercontent.com
GMAIL_API_CLIENT_SECRET=your_gmail_api_client_secret
GMAIL_API_REFRESH_TOKEN=your_gmail_api_refresh_token
GMAIL_API_ACCESS_TOKEN=

# =================================================================
# 3. GMAIL APP PASSWORD / SMTP (Alternative to OAuth2 - Recommended)
# =================================================================
SMTP_USER=your_company_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
